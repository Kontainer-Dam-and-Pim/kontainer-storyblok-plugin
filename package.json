{
  "name": "kontainer-plugin-storyblok",
  "description": "Storyblok field plugin that lets editors pick files from Kontainer's DAM in CMS mode.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Kontainer",
  "private": true,
  "repository": {
    "type": "git",
    "url": "ssh://git@git.konform.com:7999/konform/kontainer-plugin-storyblok.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx @storyblok/field-plugin-cli@latest deploy --name kontainer --scope partner-portal --skipPrompts"
  },
  "dependencies": {
    "@storyblok/field-plugin": "1.7.1",
    "vue": "^3.2.47"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/user-event": "14.6.1",
    "@testing-library/vue": "8.1.0",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vitest/ui": "2.1.9",
    "jsdom": "23.0.1",
    "typescript": "5.8.2",
    "vite": "5.4.16",
    "vite-plugin-css-injected-by-js": "3.1.0",
    "vitest": "2.1.9",
    "vue-tsc": "2.2.8"
  }
}
