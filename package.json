{
  "name": "kontainer-storyblok-plugin",
  "description": "Storyblok field plugin that lets editors pick files from Kontainer's DAM in CMS mode.",
  "version": "1.0.2",
  "license": "MIT",
  "author": "Kontainer",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Kontainer-Dam-and-Pim/kontainer-storyblok-plugin.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && pnpm dlx @storyblok/field-plugin-cli@latest deploy --name kontainer --scope partner-portal --skipPrompts"
  },
  "dependencies": {
    "@storyblok/field-plugin": "1.7.2",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/user-event": "14.6.13",
    "@testing-library/vue": "8.1.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/ui": "5.1.2",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-css-injected-by-js": "5.0.3",
    "vitest": "5.1.2",
    "vue-tsc": "3.3.14"
  }
}
